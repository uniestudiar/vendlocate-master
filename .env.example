# VendLocate Pro environment variables.

# Vite build-time values used by the browser client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# The public site origin used in confirmation links (no trailing slash).
# Set this to your Vercel URL in Vercel and to http://localhost:5173 locally.
VITE_SITE_URL=https://your-project.vercel.app
# Optional deployed Supabase Edge Function base URL.
# VITE_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1/make-server

# Vercel server-side values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set only in local development. Never enable this in production.
ENABLE_TEST_PAYMENTS=false

# Required by the search/payment APIs.
# GOOGLE_PLACES_API_KEY=...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
